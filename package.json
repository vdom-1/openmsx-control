{
  "name": "@vdom-1/openmsx-control",
  "version": "1.0.0",
  "os": [
    "win32"
  ],
  "description": "Control the openMSX emulator with your AI application using the Model Context Protocol.",
  "keywords": [
    "mcp",
    "ai",
    "agent",
    "agentic",
    "tool",
    "openmsx",
    "emulator",
    "automation"
  ],
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "openmsx-mcp": "dist/server.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.0-beta.3",
    "@modelcontextprotocol/node": "^2.0.0-beta.3",
    "@modelcontextprotocol/server": "^2.0.0-beta.3",
    "node-expose-sspi": "^0.1.60",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.5",
    "concurrently": "^10.0.3",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "tsc",
    "launch-http": "npm run build && concurrently \"npm run server\" \"npx @modelcontextprotocol/inspector\"",
    "server": "node --env-file=.env.local-http dist/index.js",
    "launch-stdio": "npm run build && npx @modelcontextprotocol/inspector --config ./mcp-stdio.json --server openmsx-control",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vdom-1/openmsx-control.git"
  }
}
